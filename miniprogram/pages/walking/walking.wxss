page {
  background: #f7f8f5;
}

.page {
  min-height: 100vh;
  padding: 36rpx 30rpx 60rpx;
  box-sizing: border-box;
}


/* ========================
   Header
======================== */

.walking-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.header-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.header-small {
  font-size: 23rpx;
  line-height: 34rpx;
  color: #999999;
}

.route-title {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 52rpx;
  color: #222222;
}

.walking-status {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  padding: 10rpx 16rpx;
  background: #e9f7ed;
  border-radius: 18rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  background: #58b978;
  border-radius: 50%;
}

.status-text {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #439a61;
}


/* ========================
   Timer
======================== */

.timer-card {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 34rpx 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.timer-label {
  font-size: 23rpx;
  line-height: 32rpx;
  color: #888888;
}

.timer-value {
  margin-top: 6rpx;
  font-size: 58rpx;
  font-weight: 600;
  line-height: 76rpx;
  letter-spacing: 2rpx;
  color: #3f7050;
}

.timer-start {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #aaaaaa;
}


/* ========================
   Route summary
======================== */

.summary-card {
  width: 100%;
  margin-bottom: 28rpx;
  padding: 24rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.035);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 42rpx;
  color: #444444;
}

.summary-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #999999;
}

.summary-divider {
  width: 1rpx;
  height: 52rpx;
  background: #edf0ed;
}


/* ========================
   Map
======================== */

.map-section {
  width: 100%;
  margin-bottom: 26rpx;
}

.section-header {
  width: 100%;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: #333333;
}

.section-hint {
  font-size: 21rpx;
  line-height: 30rpx;
  color: #999999;
}

.walking-map {
  width: 100%;
  height: 560rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.location-message {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  color: #999999;
}


/* ========================
   Map legend
======================== */

.map-legend {
  width: 100%;
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 6rpx 10rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.start-dot {
  background: #58b978;
}

.poi-dot {
  background: #208ca8;
}

.current-dot {
  background: #4285f4;
}

.legend-line {
  width: 38rpx;
  height: 6rpx;
  margin-right: 8rpx;
  background: #20bfea;
  border-radius: 6rpx;
}

.legend-text {
  font-size: 20rpx;
  line-height: 28rpx;
  color: #777777;
}


/* ========================
   POI card
======================== */

.poi-card {
  width: 100%;
  margin-bottom: 22rpx;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.035);
}

.card-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 38rpx;
  color: #444444;
}

.poi-row {
  width: 100%;
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  box-sizing: border-box;
}

.poi-row + .poi-row {
  border-top: 1rpx solid #edf0ed;
}

.poi-number {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef7f1;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 46rpx;
  color: #4d7459;
}

.poi-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.poi-name {
  font-size: 25rpx;
  font-weight: 500;
  line-height: 36rpx;
  color: #444444;
  word-break: break-all;
}

.poi-address {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #999999;
  word-break: break-all;
}


/* ========================
   Walking hint
======================== */

.walking-hint {
  width: 100%;
  margin-bottom: 26rpx;
  padding: 24rpx 26rpx;
  display: flex;
  flex-direction: column;
  background: #eef7f1;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.hint-title {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  color: #4d7459;
}

.hint-text {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 38rpx;
  color: #647568;
}


/* ========================
   Action buttons
======================== */

.action-buttons {
  width: 100%;
  margin-top: 6rpx;
  display: flex;
}

.end-button,
.finish-button {
  flex: 1;
  height: 84rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 80rpx;
}

.end-button {
  margin-right: 18rpx;
  background: #ffffff;
  color: #777777;
  border: 2rpx solid #d6dcd7;
}

.finish-button {
  background: #66c987;
  color: #ffffff;
  font-weight: 500;
}

.end-button::after,
.finish-button::after {
  border: none;
}

.end-button[disabled],
.finish-button[disabled] {
  opacity: 0.6;
}


/* ========================
   Loading / Error
======================== */

.state-container {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: #444444;
}

.state-description {
  max-width: 560rpx;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 38rpx;
  color: #999999;
}

.back-button {
  height: 76rpx;
  margin-top: 32rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #66c987;
  color: #ffffff;
  border-radius: 22rpx;
  font-size: 26rpx;
  line-height: 76rpx;
}

.back-button::after {
  border: none;
}