<view class="detail-page">
  <view class="card heading">
    <text class="eyebrow">走过的日常</text>
    <text class="title">散步详情</text>
    <text wx:if="{{walkState === 'loading'}}" class="note">正在加载散步记录…</text>
    <view wx:elif="{{walkState === 'error'}}"><text class="note">散步记录暂时无法加载。</text><button bindtap="retryWalk">重试基本信息</button></view>
    <text wx:elif="{{walkState === 'unavailable'}}" class="note">这条散步记录暂不可查看。</text>
    <view wx:else>
      <text class="date">{{walk.dateText}}</text>
      <view class="row"><text class="section-title">{{walk.routeText}}</text><text class="badge">{{walk.statusText}}</text></view>
      <text class="value">{{walk.plannedText}}</text>
      <text class="label">实际经过时长</text><text class="elapsed">{{walk.elapsedText}}</text>
      <text class="note">从开始到正式结束的经过时间，不代表持续运动时长。</text>
    </view>
  </view>
  <view class="card">
    <view class="row"><text class="section-title">这次的评价</text><text class="badge">只读</text></view>
    <text wx:if="{{feedbackState === 'loading'}}" class="note">正在加载评价…</text>
    <text wx:elif="{{feedbackState === 'empty'}}" class="note">这次散步还没有留下评价。</text>
    <view wx:elif="{{feedbackState === 'error'}}"><text class="note">评价暂时无法加载。</text><button bindtap="retryFeedback">重试评价</button></view>
    <view wx:else>
      <view class="row field"><text>评分</text><text class="score">{{feedback.ratingText}}</text></view>
      <view class="row field"><text>实际人流</text><text>{{feedback.crowdText}}</text></view>
      <view class="row field"><text>会推荐吗</text><text>{{feedback.recommendText}}</text></view>
      <text wx:if="{{feedback.positiveTags.length}}" class="label">觉得不错的</text>
      <view class="tags"><text wx:for="{{feedback.positiveTags}}" wx:key="key" class="tag">{{item.text}}</text></view>
      <text wx:if="{{feedback.negativeTags.length}}" class="label">希望改进的</text>
      <view class="tags"><text wx:for="{{feedback.negativeTags}}" wx:key="key" class="tag negative">{{item.text}}</text></view>
      <text wx:if="{{feedback.comment}}" class="comment" user-select="{{true}}">{{feedback.comment}}</text>
    </view>
  </view>
  <view class="card">
    <text class="section-title">实际定位记录</text>
    <text wx:if="{{walkState !== 'ready'}}" class="note">加载有效的散步信息后，可查看轨迹记录情况。</text>
    <text wx:elif="{{gpsState === 'disabled'}}" class="note">本次散步未开启轨迹记录。</text>
    <view wx:else>
      <text class="note">仅在你点击后加载本次散步的历史定位，不获取当前位置。</text>
      <text wx:if="{{walk.lateCleanup}}" class="note">正式结束后的收尾采样不在展示范围内。</text>
      <text wx:if="{{walk.recordedPartial}}" class="note">本次记录被标记为可能不完整，具体原因无法确定。</text>
      <button wx:if="{{gpsState === 'idle'}}" class="primary" bindtap="loadTrace" disabled="{{gpsCooldown || gpsExhausted}}">查看实际轨迹</button>
      <button wx:elif="{{gpsState === 'loading'}}" loading disabled>正在加载定位记录</button>
      <view wx:elif="{{gpsState === 'error'}}"><text class="note">{{gpsError}}</text><button bindtap="loadTrace" disabled="{{gpsCooldown || gpsExhausted}}">重试轨迹</button></view>
      <view wx:elif="{{gpsState === 'empty'}}"><text class="note">本次暂无可显示的定位记录。</text><text class="note">可能是定位点较少，或部分记录未能显示。</text><button bindtap="loadTrace" disabled="{{gpsCooldown || gpsExhausted}}">重新查看</button></view>
      <view wx:elif="{{gpsState === 'ready'}}">
        <text wx:if="{{map.total === 1}}" class="note">本次记录到 1 个定位点。</text>
        <text wx:else class="note">展示 {{map.displayed}} / {{map.total}} 个定位点。</text>
        <map class="trace-map" latitude="{{map.center.latitude}}" longitude="{{map.center.longitude}}" scale="16"
          markers="{{map.markers}}" polyline="{{map.polyline}}" include-points="{{map.includePoints}}"
          show-location="{{false}}" enable-scroll="{{true}}" enable-zoom="{{true}}" enable-rotate="{{false}}" />
        <text wx:if="{{map.segmented}}" class="note">无法确认连续的记录分段展示，断开处不补画路径。</text>
        <text wx:if="{{map.limited}}" class="note">记录较多，仅展示前一部分原始定位点，未展示部分不连线。</text>
      </view>
      <block wx:if="{{gpsState !== 'ready' && gpsState !== 'loading'}}">
        <text wx:if="{{gpsExhausted}}" class="note">本次查看次数已达上限，可以稍后重新进入查看。</text>
        <text wx:elif="{{gpsCooldown}}" class="note">请稍后再试，每次查询开始后需间隔 60 秒。</text>
      </block>
      <text wx:if="{{tracePartial}}" class="note">显示的是本次散步正式结束前的定位记录，部分采样可能未展示。</text>
      <text class="note">定位存在误差，展示结果不保证完整覆盖本次散步。</text>
    </view>
  </view>
</view>
