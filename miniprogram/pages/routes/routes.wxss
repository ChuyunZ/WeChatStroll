page {
  background: #f7f8f5;
}

.poi-list {
  margin-top: 22rpx;
  padding: 20rpx;
  background: #f8faf7;
  border-radius: 16rpx;
}

.poi-row {
  margin-top: 10rpx;
  color: #555555;
  font-size: 24rpx;
  line-height: 36rpx;
  word-break: break-all;
}

.page {
  min-height: 100vh;
  padding: 36rpx 30rpx 60rpx;
  box-sizing: border-box;
}


/* ========================
   Header
======================== */

.header {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 90rpx 0;
  margin-bottom: 38rpx;
  box-sizing: border-box;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 52rpx;
  color: #222222;
  text-align: center;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #999999;
  text-align: center;
}


/* ========================
   Avatar
======================== */

.avatar {
  position: absolute;
  top: 0;
  right: 4rpx;

  width: 72rpx;
  height: 72rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #eef7f1;
  border: 2rpx solid #53725f;
  border-radius: 50%;

  box-sizing: border-box;
}

.avatar-person {
  font-size: 38rpx;
  line-height: 72rpx;
  text-align: center;
}


/* ========================
   Route list
======================== */

.route-list {
  width: 100%;
}


/* ========================
   Route card
======================== */

.route-card {
  width: 100%;
  margin-bottom: 30rpx;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}


/* ========================
   Main layout
======================== */

.route-main {
  width: 100%;
  display: flex;
  align-items: flex-start;
}


/* ========================
   Map preview
======================== */

.preview-map {
  flex-shrink: 0;
  width: 270rpx;
  height: 270rpx;
  margin-right: 18rpx;
  border-radius: 20rpx;
  overflow: hidden;
}


/* ========================
   Right summary
======================== */

.route-summary {
  flex: 1;
  min-width: 0;
  min-height: 270rpx;

  display: flex;
  flex-direction: column;
  align-items: stretch;
}


/* ========================
   Title
======================== */

.route-title {
  width: 100%;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: #222222;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


/* ========================
   Route type
======================== */

.route-type {
  align-self: flex-start;

  min-height: 40rpx;
  margin-top: 8rpx;
  padding: 0 12rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #edf7f0;
  border-radius: 14rpx;

  box-sizing: border-box;

  color: #4a9b67;
  font-size: 19rpx;
  line-height: 26rpx;
}


/* ========================
   Information panel
======================== */

.info-panel {
  width: 100%;
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  background: #f8faf7;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.info-row {
  min-height: 38rpx;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-row + .info-row {
  border-top: 1rpx solid #edf1eb;
}

.info-label {
  font-size: 20rpx;
  line-height: 30rpx;
  color: #8c8c8c;
}

.info-value {
  font-size: 21rpx;
  line-height: 30rpx;
  font-weight: 500;
  color: #5a5a5a;
}


/* ========================
   Tags
======================== */

.tags {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 10rpx;
}

.tag {
  min-height: 38rpx;

  margin-right: 8rpx;
  margin-bottom: 6rpx;
  padding: 0 10rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #edf5ed;
  border-radius: 13rpx;

  box-sizing: border-box;

  color: #52745b;
  font-size: 18rpx;
  line-height: 24rpx;
  white-space: nowrap;
}


/* ========================
   Recommendation
======================== */

.reason {
  width: 100%;
  margin-top: 22rpx;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  background: #f8faf7;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.reason-label {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  color: #555555;
}

.reason-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 40rpx;
  color: #666666;
}


/* ========================
   Buttons
======================== */

.view-route-button {
  height: 82rpx;
  margin-top: 22rpx;
  padding: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #66c987;
  color: #ffffff;
  border-radius: 22rpx;

  font-size: 28rpx;
  font-weight: 500;
  line-height: 82rpx;
}

.view-route-button::after {
  border: none;
}

.other-routes-button {
  height: 82rpx;
  margin-top: 12rpx;
  padding: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #ffffff;
  color: #4a9b67;

  border: 2rpx solid #66c987;
  border-radius: 22rpx;

  box-sizing: border-box;

  font-size: 28rpx;
  line-height: 78rpx;
}

.other-routes-button::after {
  border: none;
}

.replacement-hint {
  margin: 16rpx 0;
  color: #4a9b67;
  font-size: 26rpx;
  line-height: 40rpx;
}


/* ========================
   States
======================== */

.state-container {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: #444444;
}

.state-description {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #999999;
}

.secondary-button {
  height: 76rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #66c987;
  color: #ffffff;
  border-radius: 22rpx;

  font-size: 28rpx;
  line-height: 76rpx;
}

.secondary-button::after {
  border: none;
}
.best-match {
  align-self: flex-start;
  display: inline-block;
  padding: 4rpx 12rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  color: #087e9b;
  background: #e4f8fc;
  font-size: 22rpx;
}
