<view class="page">

<!-- Loading -->
<view
  class="state-container"
  wx:if="{{loading}}"
>
  <text class="state-title">
    正在加载路线...
  </text>

  <text class="state-description">
    请稍等一下
  </text>
</view>


<!-- Error -->
<view
  class="state-container"
  wx:elif="{{error}}"
>
  <text class="state-title">
    无法加载这条路线
  </text>

  <text class="state-description">
    路线数据可能不存在
  </text>

  <button
    class="back-button"
    bindtap="replaceRoute"
  >
    返回路线推荐
  </button>
</view>


<!-- Main content -->
<view wx:else>

  <!-- Header -->
  <view class="detail-header">

    <view class="header-content">

      <text class="header-small">
        {{hasPreview ? '自定义路线预览（未确认）' : route.routeOrder.source === 'user' ? '你确认的路线' : '为你推荐的路线'}}
      </text>

      <text class="route-title">
        {{route.title}}
      </text>

    </view>

    <view class="avatar">
      <view class="avatar-person">
        🚶🏻
      </view>
    </view>

  </view>


  <!-- Tags -->
  <view class="tags">

    <view class="route-type">
      {{route.routeTypeText}}
    </view>

    <view
      class="tag"
      wx:for="{{route.displayTags}}"
      wx:for-item="tag"
      wx:key="*this"
    >
      {{tag}}
    </view>

  </view>


  <!-- Route information -->
  <view class="info-card">

    <text class="card-title">
      路线信息
    </text>


    <view class="info-list">

      <view class="info-row">

        <text class="info-label">
          预计时间
        </text>

        <text class="info-value">
          {{route.durationMinutes}} 分钟
        </text>

      </view>


      <view class="info-row">

        <text class="info-label">
          路线距离
        </text>

        <text class="info-value">
          {{route.distanceKm}} km
        </text>

      </view>


      <view class="info-row">

        <text class="info-label">
          人流量
        </text>

        <text class="info-value crowd-value">
          {{route.crowdText}}
        </text>

      </view>

    </view>

  </view>


  <!-- Map -->
  <view class="map-section">

    <view class="section-header">

      <text class="section-title">
        路线地图
      </text>

      <text class="section-hint">
        可拖动和缩放
      </text>

    </view>


    <map
      class="route-map"

      latitude="{{mapLatitude}}"
      longitude="{{mapLongitude}}"

      scale="16"

      polyline="{{mapPolyline}}"
      markers="{{markers}}"

      include-points="{{mapPoints}}"

      enable-scroll="{{true}}"
      enable-zoom="{{true}}"
      enable-rotate="{{false}}"
    >
    </map>


    <view class="map-legend">

      <view class="legend-item">
        <view class="legend-dot start-dot"></view>
        <text class="legend-text">
          {{route.returnsToStart ? '起点 / 返回点' : '起点'}}
        </text>
      </view>

      <view class="legend-item legend-middle">
        <view class="legend-line"></view>
        <text class="legend-text">
          步行路线
        </text>
      </view>

      <view class="legend-item">
        <view class="legend-dot poi-dot"></view>
        <text class="legend-text">编号地点</text>
      </view>

      <view class="legend-item" wx:if="{{!route.returnsToStart}}">
        <view class="legend-dot end-dot"></view>
        <text class="legend-text">
          终点
        </text>
      </view>

    </view>

  </view>


  <!-- Description -->
  <view class="content-card" wx:if="{{canEdit}}">
    <text class="card-title">路线地点</text>
    <button wx:if="{{!editing}}" class="edit-button" bindtap="enterRouteEdit">编辑路线地点</button>
    <block wx:else>
      <text class="content-text">调整访问顺序，也可移除地点后重新加入。地图在预览成功后更新。</text>
      <view class="edit-poi" wx:for="{{activeWaypoints}}" wx:for-item="poi" wx:key="poiId">
        <text class="edit-poi-name">{{poi.visitNumber}}. {{poi.name}}</text>
        <text class="destination-label" wx:if="{{poi.isDestination}}">当前终点</text>
        <text class="poi-metadata">{{poi.categoryLabel}}</text>
        <text class="poi-metadata" wx:if="{{poi.address}}">{{poi.address}}</text>
        <text class="poi-metadata" wx:if="{{poi.hasDistance}}">距原始起点约 {{poi.distanceInMeters}} 米</text>
        <view class="edit-controls">
          <button class="edit-button" data-id="{{poi.poiId}}" data-direction="-1" disabled="{{index === 0 || confirming}}" bindtap="moveWaypoint">上移</button>
          <button class="edit-button" data-id="{{poi.poiId}}" data-direction="1" disabled="{{index === activeWaypoints.length - 1 || confirming}}" bindtap="moveWaypoint">下移</button>
          <button class="edit-button" data-id="{{poi.poiId}}" disabled="{{activeWaypoints.length === 1 || confirming}}" bindtap="removeWaypoint">移除</button>
        </view>
      </view>
      <text class="card-title" wx:if="{{removedWaypoints.length}}">已移除地点</text>
      <view class="edit-poi" wx:for="{{removedWaypoints}}" wx:for-item="poi" wx:key="poiId">
        <text class="edit-poi-name">{{poi.name}}（已移除）</text>
        <text class="poi-metadata">{{poi.categoryLabel}}</text>
        <text class="poi-metadata" wx:if="{{poi.address}}">{{poi.address}}</text>
        <text class="poi-metadata" wx:if="{{poi.hasDistance}}">距原始起点约 {{poi.distanceInMeters}} 米</text>
        <button class="edit-button" data-id="{{poi.poiId}}" disabled="{{confirming}}" bindtap="addWaypoint">重新加入</button>
      </view>
      <text class="content-text" wx:if="{{editMessage}}">{{editMessage}}</text>
      <button class="edit-button" disabled="{{previewLoading || confirming}}" bindtap="restoreRecommendation">恢复推荐路线并预览</button>
      <button class="edit-button" loading="{{previewLoading}}" disabled="{{previewLoading || confirming}}" bindtap="previewRoute">{{previewLoading ? '正在更新路线…' : '预览真实路线'}}</button>
      <view class="edit-controls">
        <button class="edit-button" disabled="{{confirming}}" bindtap="cancelRouteEdit">取消编辑</button>
        <button class="edit-button" loading="{{confirming}}" disabled="{{!hasPreview || previewLoading || confirming}}" bindtap="confirmRouteEdit">确认路线</button>
      </view>
    </block>
    <text class="content-text" wx:if="{{route.durationDifference !== null}}">推荐 {{route.recommendedDurationMinutes}} 分钟 · 当前 {{route.durationMinutes}} 分钟{{route.durationDifference > 0 ? ' · 多 ' + route.durationDifferenceAbs + ' 分钟' : route.durationDifference < 0 ? ' · 少 ' + route.durationDifferenceAbs + ' 分钟' : ''}}</text>
  </view>

  <view class="content-card" wx:if="{{route.displayPois.length}}">
    <text class="card-title">途经地点（按访问顺序）</text>
    <view class="poi-row" wx:for="{{route.displayPois}}" wx:for-item="poi" wx:key="visitNumber">
      <text>{{poi.visitNumber}}. {{poi.displayName}}</text>
    </view>
  </view>

  <view class="content-card">

    <text class="card-title">
      路线介绍
    </text>

    <text class="content-text">
      {{route.description}}
    </text>

  </view>


  <!-- Recommendation -->
  <view class="content-card recommendation-card">

    <text class="card-title">
      为什么推荐给你
    </text>

    <text class="content-text">
      {{route.recommendationReason}}
    </text>

  </view>


  <!-- Actions -->
  <view class="action-buttons">

    <button
      class="replace-button"
      bindtap="replaceRoute"
    >
      换一条路线
    </button>

    <button
      class="start-button"
      disabled="{{editing}}"
      bindtap="startWalk"
    >
      开始散步
    </button>

  </view>

</view>

</view>
