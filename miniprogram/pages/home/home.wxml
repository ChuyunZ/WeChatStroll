<view class="container">

<!-- Welcome chat -->
<view class="welcome-section">

  <!-- Walking avatar -->
  <view class="walking-avatar">
    <text class="walking-person">🚶‍♀️</text>
  </view>

  <!-- Chat bubble -->
  <view class="chat-bubble">

    <!-- Bubble tail -->
    <view class="chat-tail"></view>

    <text class="welcome-title">Let's 散步</text>

    <text class="welcome-subtitle">
      嗨，新朋友快进来
    </text>

  </view>

</view>


<button class="profile-entry" bindtap="goProfile" hover-class="profile-entry-active">
  <view class="profile-entry-copy"><text class="profile-entry-title">我的散步</text><text class="profile-entry-subtitle">回看散步记录，看看我们了解的你</text></view>
  <text class="profile-entry-arrow">›</text>
</button>

<!-- Primary CTA -->
<view
  class="bottom-action"
  bindtap="goPreference"
  hover-class="bottom-action-active"
>
  <text class="bottom-action-text">
    开始规划散步
  </text>
</view>

</view>
