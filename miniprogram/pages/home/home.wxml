<view class="page">

<!-- 上面的聊天内容 -->
<view class="chat-row">
  <view class="avatar">
    <text class="avatar-emoji">🏃</text>
  </view>

  <view class="chat-bubble">
    <view class="bubble-tail"></view>

    <text class="welcome-title">欢迎来到微信散步</text>
    <text class="welcome-subtitle">嗨，新朋友快进来</text>
  </view>
</view>

<view
  class="bottom-action"
  bindtap="goPreference"
  hover-class="bottom-action-active"
>
  <text class="bottom-action-text">开始散步</text>
</view>

</view>