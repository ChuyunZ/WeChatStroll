.page {
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;

  padding: 60rpx 32rpx 220rpx;
}


/* =========================
   Chat message
   ========================= */

.chat-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}


/* Avatar */

.avatar {
  width: 82rpx;
  height: 82rpx;

  background: #ffffff;
  border-radius: 12rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 50rpx;
  line-height: 1;
}


/* Chat bubble */

.chat-bubble {
  position: relative;

  margin-left: 24rpx;

  max-width: 500rpx;
  min-height: 110rpx;

  background: #ffffff;
  border-radius: 10rpx;

  box-sizing: border-box;
  padding: 22rpx 26rpx;

  display: flex;
  flex-direction: column;
}


/* Small triangle on left of bubble */

.bubble-tail {
  position: absolute;

  left: -16rpx;
  top: 26rpx;

  width: 0;
  height: 0;

  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-right: 18rpx solid #ffffff;
}


.welcome-title {
  font-size: 29rpx;
  font-weight: 500;
  color: #111111;

  line-height: 1.5;

  margin-bottom: 8rpx;
}

.welcome-subtitle {
  font-size: 22rpx;
  color: #888888;

  line-height: 1.5;
}

.page {
  min-height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
  padding: 60rpx 32rpx 180rpx;
}

.bottom-action {
  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  height: 70rpx;

  background: #ffffff;
  border-top: 1rpx solid #e8e8e8;

  display: flex;
  align-items: center;
  justify-content: center;

  padding-bottom: env(safe-area-inset-bottom);

  box-sizing: content-box;
  z-index: 100;
}

.bottom-action-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.bottom-action-active {
  background: #eeeeee;
}