page { background: #f7f7f7; color: #25382c; }
.profile-page { padding: 40rpx 28rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.page-heading { padding: 12rpx 8rpx 36rpx; }
.eyebrow { display: block; font-size: 23rpx; color: #62846c; letter-spacing: 3rpx; margin-bottom: 14rpx; }
.page-title { display: block; font-size: 52rpx; font-weight: 600; line-height: 1.3; }
.page-subtitle { display: block; margin-top: 16rpx; font-size: 26rpx; color: #6c7c71; line-height: 1.6; }
.statistics { display: flex; margin: 0 -8rpx 28rpx; }
.stat-card { flex: 1; min-width: 0; margin: 0 8rpx; padding: 28rpx 24rpx; border-radius: 24rpx; background: #fff; }
.stat-label { display: block; font-size: 26rpx; color: #526859; }
.stat-value { display: flex; align-items: baseline; flex-wrap: wrap; margin: 12rpx 0; }
.stat-number { font-size: 58rpx; font-weight: 600; color: #16743b; word-break: break-all; }
.stat-number.secondary { color: #496151; }
.stat-unit { font-size: 24rpx; color: #748279; margin-left: 10rpx; }
.stat-caption { display: block; font-size: 22rpx; color: #758078; }
.stat-pending { display: block; font-size: 28rpx; color: #758078; margin: 28rpx 0; }
.card { border-radius: 28rpx; background: #fff; padding: 30rpx 28rpx; margin-bottom: 28rpx; }
.ai-card { border-top: 6rpx solid #2fc766; }
.section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.section-title { font-size: 33rpx; font-weight: 600; line-height: 1.5; }
.section-badge { font-size: 21rpx; color: #267d45; background: #e9f8ee; padding: 6rpx 14rpx; border-radius: 20rpx; }
.section-description { display: block; margin-top: 12rpx; color: #6c7c71; font-size: 25rpx; line-height: 1.7; }
.insight { margin-top: 28rpx; }
.insight-label { display: block; font-size: 24rpx; font-weight: 600; color: #4e705a; margin-bottom: 10rpx; }
.insight-text { display: block; font-size: 28rpx; line-height: 1.75; }
.evidence { display: block; color: #748078; font-size: 23rpx; line-height: 1.7; margin-top: 8rpx; }
.tag-heading { display: block; margin-top: 20rpx; font-size: 23rpx; color: #627268; }
.tags { display: flex; flex-wrap: wrap; }
.tag { margin: 12rpx 12rpx 0 0; padding: 9rpx 16rpx; border-radius: 12rpx; font-size: 23rpx; line-height: 1.6; }
.positive { color: #237745; background: #eef8f1; }
.negative { color: #806642; background: #f8f4ec; }
.evidence-footer { margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid #edf0ed; }
.evidence-count { font-size: 24rpx; font-weight: 500; color: #516c59; }
.state-panel { padding: 38rpx 4rpx 16rpx; color: #718078; font-size: 27rpx; line-height: 1.85; }
button::after { border: none; }
button.text-button { padding: 12rpx 0 12rpx 20rpx; margin: 0; color: #188343; background: transparent; font-size: 26rpx; line-height: 1.6; }
button.small-button, button.load-more { background: #edf8f0; color: #16743b; font-size: 26rpx; border-radius: 36rpx; line-height: 2.7; }
button.small-button { margin: 24rpx 0 0; padding: 0 30rpx; display: inline-block; }
button.load-more { margin: 20rpx 0 0; }
button.load-more[disabled] { color: #6b8d74; background: #f0f5f1; }
.walk-row { padding: 28rpx 0; border-bottom: 1rpx solid #edf0ed; }
.walk-date { display: block; color: #768379; font-size: 23rpx; }
.walk-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin: 14rpx 0; }
.walk-title { font-size: 30rpx; font-weight: 500; }
.status { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 10rpx; }
.completed { color: #1d8040; background: #eaf8ee; }
.ended-early { color: #796746; background: #f7f2e9; }
.walk-durations { display: flex; flex-wrap: wrap; color: #758078; font-size: 25rpx; line-height: 1.8; }
.actual-duration { margin-left: 24rpx; color: #3e5646; }
.rating { display: block; margin-top: 12rpx; font-size: 24rpx; color: #849087; }
.rated { color: #287b44; }
.pagination { padding-top: 16rpx; }
.pagination-error { display: block; color: #a3523e; font-size: 25rpx; line-height: 1.7; }
.end-note { display: block; text-align: center; color: #89958c; padding: 18rpx 0 0; font-size: 23rpx; }
.page-footer { display: block; text-align: center; color: #8a958d; font-size: 23rpx; padding: 10rpx 0; }
