<view class="container">

  <!-- Header -->
  <view class="header">

    <view class="avatar" bindtap="goToProfile">
      <text class="avatar-person">🚶🏻</text>
    </view>

    <text class="title">个人散步偏好调查</text>
    <text class="subtitle">让AI更好的了解你</text>

  </view>


  <view wx:if="{{currentPage === 0}}">

  <!-- Q1 -->
    <view class="question-block">

      <view class="question-header">
        <view class="question-dot"></view>

        <text class="question-title">
          {{questions[0].questionText}}
        </text>
      </view>


      <picker-view
        class="time-picker"
        value="{{timePickerValue}}"
        bindchange="onTimeChange"
        indicator-class="picker-selected"
      >

      <!-- Hour -->
      <picker-view-column>

        <view
          class="picker-item"
          wx:for="{{hourOptions}}"
          wx:key="*this"
        >
          {{item}} 小时
        </view>

      </picker-view-column>

      <!-- Minute -->
      <picker-view-column>

        <view
          class="picker-item"
          wx:for="{{minuteOptions}}"
          wx:key="*this"
        >
          {{item}} 分钟
        </view>

      </picker-view-column>

    </picker-view>

  </view>


  <!-- Q2 -->
  <view class="question-block">

    <view class="question-header">

      <view class="question-dot"></view>

      <text class="question-title">
        {{questions[1].questionText}}
      </text>

    </view>


    <view
      class="option-card"
      wx:for="{{questions[1].options}}"
      wx:key="label"
      bindtap="onSingleSelect"
      data-question-index="1"
      data-option-index="{{index}}"
    >

      <text class="option-text">
        {{item.label}}
      </text>

      <view
        class="radio-circle {{item.selected ? 'selected' : ''}}"
      ></view>

    </view>

  </view>

</view>


<!-- ==================== -->
<!-- PAGE 2: Q3 + Q4 -->
<!-- ==================== -->

  <view
    wx:if="{{currentPage === 1}}"
    class="page-two"
  >

  <!-- Q3 -->
  <view class="question-block">

    <view class="question-header">

      <view class="question-dot"></view>

      <text class="question-title">
        {{questions[2].questionText}}
      </text>

    </view>


    <view
      class="option-card"
      wx:for="{{questions[2].options}}"
      wx:key="label"
      bindtap="onSingleSelect"
      data-question-index="2"
      data-option-index="{{index}}"
    >

      <text class="option-text">
        {{item.label}}
      </text>

      <view
        class="radio-circle {{item.selected ? 'selected' : ''}}"
      ></view>

    </view>

  </view>


  <!-- Q4 -->
  <view class="question-block">

    <view class="question-header">

      <view class="question-dot"></view>

      <text class="question-title">
        {{questions[3].questionText}}
      </text>

    </view>


    <view
      class="option-card"
      wx:for="{{questions[3].options}}"
      wx:key="label"
      bindtap="onMultiSelect"
      data-question-index="3"
      data-option-index="{{index}}"
    >

      <text class="option-text">
        {{item.label}}
      </text>

      <view
        class="radio-circle {{item.selected ? 'selected' : ''}}"
      ></view>

    </view>

  </view>

</view>


<view class="page-navigation">
  <view
    class="nav-arrow"
    wx:if="{{currentPage === 1}}"
    bindtap="previousPage"
  >
    ◀
  </view>

  <view
    class="nav-arrow next-arrow"
    wx:if="{{currentPage === 0}}"
    bindtap="nextPage"
  >
    ▶
  </view>

  <button
    class="recommend-button"
    wx:if="{{currentPage === 1}}"
    bindtap="goToRoutes"
  >
    推荐路线
  </button>

</view>

</view>